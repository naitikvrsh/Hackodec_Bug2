# Server Configuration
PORT=4000
NODE_ENV=development

# LLM Configuration (Optional: if omitted, app operates fully in rules-only + local extractive agent mode)
GEMINI_API_KEY=

# Firewall Thresholds (Defaults)
FIREWALL_SAFE_THRESHOLD=30
FIREWALL_MALICIOUS_THRESHOLD=70
FIREWALL_AMBIGUOUS_LOWER=25
FIREWALL_AMBIGUOUS_UPPER=70
