# AegisGuard Client Environment Configuration
# For production (Netlify), set VITE_API_URL to your deployed Render backend web service URL.
# Example: VITE_API_URL=https://aegisguard-firewall.onrender.com
#
# In local development, leave this blank so Vite automatically proxies '/api' to 'http://localhost:4000'.
VITE_API_URL=
